# ---------- Base de données ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_compliance_gateway
# Utilisé uniquement par les scripts db:create / db:reset
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# ---------- Central API ----------
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# Secret HMAC pour les JWT utilisateurs (dashboard). Générer avec: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-in-production-please-use-48-random-bytes
# Access JWT (court) — révocation via denylist jti
JWT_TTL_SECONDS=900
# Refresh opaque stocké hashé en base
JWT_REFRESH_TTL_SECONDS=604800
# Lockout après N échecs
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
# Rate-limit login par IP (fenêtre 1 min)
LOGIN_RATE_LIMIT_PER_MINUTE=5
# Clé maître du Vault (AES-256-GCM), 32 octets encodés base64. Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=ZGV2LW9ubHktdmF1bHQta2V5LTMyLWJ5dGVzLS0tLS0tLQ==
# Sel pour le hachage des identifiants utilisateur dans le journal analytique
AUDIT_USER_SALT=dev-only-audit-salt
# Délai avant alerte "agent potentiellement désactivé" (NFR-03)
HEARTBEAT_TIMEOUT_SECONDS=300
HEARTBEAT_CHECK_INTERVAL_SECONDS=30
# Juridiction de l'entreprise (utilisée pour le facteur de transfert transfrontalier)
ORGANIZATION_JURISDICTION=BJ
# Référentiel réglementaire actif au démarrage (BJ_MALABO | EU_GDPR_AIACT | US_NIST)
REGULATORY_FRAMEWORK=BJ_MALABO
# Origines autorisées (CORS) pour le dashboard et les extensions
CORS_ORIGINS=http://localhost:3000

# TLS optionnel (démo / prod locale). Laisser vide en développement HTTP.
# API_TLS_CERT=C:\certs\api.pem
# API_TLS_KEY=C:\certs\api-key.pem

# ---------- Comptes de démonstration (créés par db:seed) ----------
SEED_ADMIN_EMAIL=rssi@cnss.bj
SEED_ADMIN_PASSWORD=Admin!2026
SEED_DPO_EMAIL=dpo@cnss.bj
SEED_DPO_PASSWORD=Dpo!2026

# ---------- Dashboard ----------
VITE_API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------- Detection Engine (facultatif : modèles locaux) ----------
# Chemin vers le modèle NER ONNX (couche 2). Si absent : téléchargement hub Xenova (sauf NER_DISABLE_HUB=1).
NER_MODEL_PATH=
NER_TOKENIZER_PATH=
NER_DISABLE_HUB=
# Modèle hub (transformers.js) si aucun fichier local n'est fourni
# NER_HUB_MODEL=Xenova/bert-base-multilingual-cased-ner-hrl
# Chemin vers le modèle GGUF (couche 3). Si absent : repli classification par mots-clés.
LLM_MODEL_PATH=
# Checksums SHA-256 attendus des poids (vérification d'intégrité au chargement, section 11.1)
NER_MODEL_SHA256=
LLM_MODEL_SHA256=
# A2 : activer NER aussi sur chaque intercept CLI (lent au cold start). Le démon le charge déjà.
# ACG_ENABLE_NER=
# OCR images/PDF scannés (Node/A2) — nécessite : pnpm add tesseract.js --filter @acg/file-extract
# ACG_ENABLE_OCR=1
